# Django Settings - Copy this file to .env and fill in your values
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=
TIME_ZONE=Asia/Kolkata

# Email settings
# Development default prints emails in the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=PetCare AI <no-reply@petcare.local>

# For real SMTP email, use backend below and fill SMTP details.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False

# Firebase Cloud Messaging browser push notifications
# Get these from Firebase Console -> Project settings -> Your web app.
SITE_URL=http://127.0.0.1:8000
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_VAPID_KEY=

# Server-side Firebase Admin SDK service account JSON path.
# FIREBASE_SERVICE_ACCOUNT_FILE=C:\path\to\firebase-service-account.json

# Local demo auto-sender. Checks due reminder push notifications every 60 seconds
# while the Django runserver process is running.
AUTO_SEND_REMINDER_PUSH=True
REMINDER_PUSH_INTERVAL_SECONDS=60
