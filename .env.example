# Django Settings - Copy this file to .env and fill in your values
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=

# Email settings
# Development default prints emails in the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=PetCare AI <no-reply@petcare.local>

# For real SMTP email, use backend below and fill SMTP details.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
